OPERATOR_PIN=choose-a-private-operator-code

# Live voice: set only in ignored .dev.vars, then restart the local server.
# Requires an OpenAI account with Realtime / speech access and paid API quota.
OPENAI_API_KEY=

# Optional output-only speech providers. /voices can save these to ignored .dev.vars.
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=
