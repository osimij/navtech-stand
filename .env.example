# Copy the values you need. Never commit real values.
# Local stand: put them in ignored .dev.vars (and OPERATOR_PIN also in .env), then restart.
# Vercel: Project → Settings → Environment Variables.

# Operator contacts and CSV export (/operator). A private code for the booth team.
OPERATOR_PIN=choose-a-private-operator-code

# Vercel only: Postgres connection string. Vercel's Neon or Supabase integration sets DATABASE_URL or POSTGRES_URL
# automatically. Tables are created on first use. The local stand ignores it and keeps its Cloudflare D1 database.
DATABASE_URL=

# Narration voice (ElevenLabs, Sienna). On Vercel each approved line is generated once, then served from the database.
ELEVENLABS_API_KEY=

# Local stand only: the live voice demo (/demo) and the /voices lab.
OPENAI_API_KEY=
CARTESIA_API_KEY=
